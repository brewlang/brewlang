{
  "name": "brewlang",
  "version": "0.0.1",
  "description": "Coffee brewing markup language",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "brewlang": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "schema"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest",
    "typecheck": "tsc --noEmit && tsc -p src/cli"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.4",
    "ajv": "^8.17.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
